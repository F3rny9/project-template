{
  "permissions": {
    "allow": [
      "Bash(node scripts/verificar-cobertura.mjs)",
      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(claude mcp list)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\farias\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py"],
            "timeout": 10,
            "statusMessage": "Loading project security posture"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\farias\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-gate.py"],
            "timeout": 10,
            "statusMessage": "Security pre-check"
          }
        ]
      }
    ]
  }
}
